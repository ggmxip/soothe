{
  "expo": {
    "name": "Soothe",
    "slug": "soothe",
    "description": "A private, on-device tracker for daily habits and money spent. Mindful logging. No accounts. No ads. No servers.",
    "githubUrl": "https://github.com/ggmxip/soothe",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "primaryColor": "#FF3131",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.soothe.app",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.soothe.app",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-iap"
    ],
    "extra": {
      "eas": {
        "projectId": "9802ded9-89ee-4ed2-8037-d0a7491a14c4"
      },
      "privacyPolicyUrl": "https://soothe.app/privacy"
    },
    "owner": "ggmxip"
  }
}
